# 统一换行符：文本文件一律 LF，避免 Windows/Linux 协作产生噪音 diff
* text=auto eol=lf

# ---------- 文本 ----------
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.json    text eol=lf
*.tsv     text eol=lf
*.md      text eol=lf linguist-documentation
*.py      text eol=lf
*.sh      text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# ---------- 二进制（禁止换行转换与文本 diff）----------
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.wav     binary
*.ogg     binary
*.mp3     binary
*.glb     binary
*.gltf    binary
*.bin     binary
*.blend   binary
*.ttf     binary
*.otf     binary

# ---------- GitHub 语言统计 ----------
art/**         linguist-vendored
tests/**       linguist-test
docs/**        linguist-documentation
